# Punchable hosted worker, the Rust one (pk-worker, T8). Build context = the repo root:
#   docker build -f rust/Dockerfile.worker --build-arg PK_BUILD_SHA=$(git rev-parse HEAD) -t punchable-worker-rs .
# Built OFF the production node (docs/ARCHITECTURE.md section 6: a release cargo build is the heavy run the owner
# forbids on a box doing real work): in CI or on the PC, then `docker save` | ssh | `docker load` and pushed to the
# cluster registry. Not wired into infra/deploy.sh yet: the swap is the owner's call (docs/RUST_WORKSTREAM.md T8).
#
# What is in it: one binary (rustls, no OpenSSL; ONNX Runtime linked in by `ort` for the embedding kinds; SQLite
# compiled from its amalgamation by pk-fts for the one-shot Ask's full text) on distroless cc (glibc, libgcc,
# libstdc++), non-root uid 10001, read-only root filesystem; the bge-small model, fetched and checked against the
# hub's hashes and the fingerprint by tools/kb/fetch_bge.py (the Python image's own step); the only writes go to /tmp
# (the emptyDir in 35-worker.yaml: the heartbeat and the day's spend ledger). The engine config is compiled in
# (engine/config.hosted.toml via pk-llm's include_str!), so no ENGINE_CONFIG path exists.
# PK_WITH_BGE=0 builds without the model: the worker then claims none of embed / memolink / ask (and says so at start).
#
# Bases pinned by digest (multi-arch index digests, resolved 2026-11-02 (trixie pins 2026-11-07) with `docker buildx imagetools inspect`):
#   rust:1.99.1-slim-trixie                 = rust-toolchain.toml's 1.99.1; trixie because pyke's prebuilt ONNX Runtime needs GCC 13+ libstdc++ and glibc 2.38+
#   python:3.13-slim-bookworm               the digest infra/worker/Dockerfile pins (2026-10-22): the model stage
#                                           fetches the model exactly as the Python image does
#   gcr.io/distroless/cc-debian13:nonroot   the runtime (trixie, to match the build stage's glibc and libstdc++)
# Move a pin only on purpose, with the build log's digest in the deploy log.
FROM rust:1.99.1-slim-trixie@sha256:7eab7ce19273ce785e0ca7578bdf7bc1fcbae621775a8197379a04c9f6e03cd5 AS build
# ort-sys links its static ONNX Runtime against libstdc++: the slim image has gcc but no g++, so rust-lld finds no
# -lstdc++. Build stage only; the runtime image (distroless cc) already carries libstdc++.
RUN apt-get update \
 && apt-get install -y --no-install-recommends g++ \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY engine/config.hosted.toml engine/config.hosted.toml
COPY db/schema.surql db/schema_extra.surql db/
COPY rust/ rust/
WORKDIR /src/rust
RUN cargo build --release --locked -p pk-worker \
 && cp target/release/pk-worker /pk-worker

FROM python:3.13-slim-bookworm@sha256:e32be0e55814a08977501ca863271d9bd02443710db8f2afaf8372e2c4508530 AS model
ARG PK_WITH_BGE=1
COPY engine/*.py /src/engine/
COPY tools/kb/fetch_bge.py /src/tools/kb/fetch_bge.py
RUN mkdir -p /opt/punchable/models \
 && if [ "$PK_WITH_BGE" = 1 ]; then \
      python -m pip install --no-cache-dir --only-binary=:all: onnxruntime==1.27.0 tokenizers==0.22.1 numpy==2.2.6 \
      && python /src/tools/kb/fetch_bge.py --dest /opt/punchable/models/bge-small-en-v1.5; \
    fi

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:08476c244888bfb425bae1ae4dd7c17f093e972aab8426883d97f3c6f280f7c1
COPY --from=build /pk-worker /pk-worker
COPY --from=model /opt/punchable/models /opt/punchable/models
ARG PK_BUILD_SHA=dev
ENV PK_BUILD_SHA=$PK_BUILD_SHA \
    HOME=/tmp \
    PK_HOSTED=1 \
    PK_WORKSPACE=/tmp/pk-worker \
    PK_HEARTBEAT_FILE=/tmp/pk-worker/heartbeat \
    PK_AI_SPEND_FILE=/tmp/pk-worker/ai_spend.json \
    PK_BGE_DIR=/opt/punchable/models/bge-small-en-v1.5 \
    PUNCH_SECRETS=/nonexistent \
    RUST_LOG=info
USER 10001:10001
# GET /metrics and /healthz for Prometheus (PK_METRICS_PORT): the only thing this image listens on
EXPOSE 9100
ENTRYPOINT ["/pk-worker"]
