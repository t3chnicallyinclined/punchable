# Copy to ~/.punchable/infra.env (or infra/config.env, gitignored) and fill in. infra/ship.sh sends it to the server. No secrets in this file (secrets go into k8s Secrets by infra/secrets.sh).
# Every script under infra/ sources it, and every manifest is rendered from it (render.sh refuses a leftover
# __PK_ placeholder).
PK_DOMAIN=example.com
PK_AUTH_HOST=auth.example.com
# Keycloak sends from this address (Cloudflare Email Sending or any SMTP you configure in the realm).
PK_MAIL_FROM=no-reply@example.com
# Kubernetes namespace for Punchable, and the namespace of the Keycloak it uses.
PK_NS=punchable
PK_KC_NS=keycloak
PK_REALM=punchable
# Public IP of the server (DNS A records point here).
PK_ORIGIN_IP=203.0.113.10
# The one user of the realm.
PK_OWNER_EMAIL=you@example.com
# Keycloak image used for the throwaway realm test (pin by digest), e.g. quay.io/keycloak/keycloak@sha256:...
PK_KC_IMAGE=quay.io/keycloak/keycloak:26.0
# ssh target for infra/ship.sh
PK_SSH_HOST=ubuntu@203.0.113.10
PK_SSH_KEY=$HOME/.ssh/id_ed25519
# The actor id written on your own edits (`by` in decisions and stores). Keep it equal to the id in your data.
PK_OWNER_ID=owner
# How the AI prompts name you (rendered into the API and worker manifests as PK_COMIC_NAME / PK_COMIC_FIRST).
# Unset: "the comic", and the prompts read "a stand-up comic's material", "his idea". The first name defaults to the name.
# PK_COMIC_NAME="Pat Example"     (quote a value with a space: every script sources this file)
# PK_COMIC_FIRST=Pat
# Optional: the comment tag on DNS records infra/dns/cf_dns.py made (only if you made them under another tag).
# PK_DNS_TAG=
# Apple Developer Team ID (10 characters) for Universal Links on the iPhone app: the web image's
# /.well-known/apple-app-site-association names it. Leave unset until the owner has one (the placeholder TEAMID stays).
# PK_APPLE_TEAM_ID=
