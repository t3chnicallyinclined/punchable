# Copy to infra/config.env and fill in. No secrets in this file (secrets go into k8s Secrets by infra/secrets.sh).
# Every script under infra/ sources it, and every manifest is rendered from it (render.sh refuses a leftover
# __PK_ placeholder).
PK_DOMAIN=example.com
PK_AUTH_HOST=auth.example.com
# Keycloak sends from this address (Cloudflare Email Sending or any SMTP you configure in the realm).
PK_MAIL_FROM=no-reply@example.com
# Kubernetes namespace for Punchable, and the namespace of the Keycloak it uses.
PK_NS=punchable
PK_KC_NS=keycloak
PK_REALM=punchable
# Public IP of the server (DNS A records point here).
PK_ORIGIN_IP=203.0.113.10
# The one user of the realm.
PK_OWNER_EMAIL=you@example.com
# Keycloak image used for the throwaway realm test (pin by digest), e.g. quay.io/keycloak/keycloak@sha256:...
PK_KC_IMAGE=quay.io/keycloak/keycloak:26.0
# ssh target for infra/ship.sh
PK_SSH_HOST=ubuntu@203.0.113.10
PK_SSH_KEY=$HOME/.ssh/id_ed25519
