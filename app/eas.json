{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://punchable.io/api",
        "EXPO_PUBLIC_AUTH": "1",
        "EXPO_PUBLIC_ENV": "preview",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://punchable.io/api",
        "EXPO_PUBLIC_AUTH": "1",
        "EXPO_PUBLIC_ENV": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "dev-device": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://punchable.io/api",
        "EXPO_PUBLIC_AUTH": "1",
        "EXPO_PUBLIC_ENV": "dev",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6827804371",
        "appleTeamId": "26X45RAY9D"
      }
    }
  }
}
